<Window x:Class="FloatingLyrics.App.Views.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floating Lyrics Overlay" Width="900" Height="180" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Topmost="True" Focusable="False" UseLayoutRounding="True">
    <Border x:Name="EditSurface" CornerRadius="12" Padding="20,10" Background="Transparent" MouseLeftButtonDown="DragOverlay">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel x:Name="EditToolbar" LastChildFill="False" Visibility="Collapsed" Margin="0,0,0,4">
                <TextBlock Text="DRAG TO POSITION" FontSize="10" Foreground="#B8C8D8" VerticalAlignment="Center" Margin="0,0,18,0" />
                <Button Content="Lock overlay" Click="LockOverlay" Padding="10,5" FontSize="11" />
            </DockPanel>
            <TextBlock x:Name="LyricText" Grid.Row="1" Text="{Binding CurrentLyric}" FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}" FontWeight="SemiBold" Foreground="{Binding LyricBrush}" Opacity="{Binding TextOpacity}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Stretch" IsHitTestVisible="False">
                <TextBlock.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.85" Color="Black" /></TextBlock.Effect>
            </TextBlock>
        </Grid>
    </Border>
</Window>

<Window x:Class="FloatingLyrics.App.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floating Lyrics" Width="860" Height="820" MinWidth="670" MinHeight="560" Background="{StaticResource PageBrush}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="30,26,30,24">
            <StackPanel><TextBlock Text="Floating Lyrics" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Your music, quietly in view." Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#28392F" CornerRadius="4" Padding="10,5"><TextBlock Text="0.1 · MVP" Foreground="#AFD9BE" FontSize="11" /></Border>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,0,30,12">
            <StackPanel>
                <Border Style="{StaticResource Section}" Background="#202F39">
                    <StackPanel>
                        <TextBlock Text="{Binding Status}" Foreground="#92D9D2" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding Track}" FontSize="21" FontWeight="SemiBold" Margin="0,10,0,6"/>
                        <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                        <WrapPanel Margin="0,18,0,0"><Button Content="Retry lyrics" Command="{Binding RetryCommand}"/><CheckBox Content="Show lyrics overlay" IsChecked="{Binding OverlayEnabled}" Margin="10,4,0,0"/></WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Music &amp; lyrics" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Media source" Margin="0,0,0,7"/>
                        <ComboBox ItemsSource="{Binding SessionNames}" SelectedIndex="{Binding SelectedSessionIndex}" Padding="8" Margin="0,0,0,16" AutomationProperties.Name="Media source"/>
                        <TextBlock Text="Timing compensation"/>
                        <DockPanel Margin="0,6,0,4"><TextBlock DockPanel.Dock="Right" Text="{Binding TimingOffsetMs, StringFormat={}{0} ms}" Width="76" TextAlignment="Right"/><Slider Minimum="-10000" Maximum="10000" TickFrequency="100" IsSnapToTickEnabled="True" Value="{Binding TimingOffsetMs}" AutomationProperties.Name="Timing compensation"/></DockPanel>
                        <TextBlock Text="Positive values show lyrics earlier. Seeking always follows the player's reported timeline." Style="{StaticResource Caption}"/>
                        <TextBlock Text="Public GitHub repository URL · LRCLIB client identification" Margin="0,18,0,7"/>
                        <TextBox Text="{Binding LrcLibClientUrl, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="LRCLIB project URL"/>
                        <TextBlock Text="Set LrcLibClientUrl to this project's public repository URL. Online lookup stays disabled while it is unset. LRCLIB requires an app name, version and project URL; no account or API key is needed." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Font family" Margin="0,0,0,7"/>
                        <ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding FontFamily}" IsTextSearchEnabled="True" MaxDropDownHeight="250" Padding="8" AutomationProperties.Name="Font family"/>
                        <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Font size"/><DockPanel Margin="0,8,0,0"><TextBlock Text="{Binding FontSize, StringFormat={}{0:0} px}" DockPanel.Dock="Right" Width="50" TextAlignment="Right"/><Slider Minimum="14" Maximum="72" Value="{Binding FontSize}" AutomationProperties.Name="Font size"/></DockPanel></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Text opacity"/><Slider Minimum="0.2" Maximum="1" Value="{Binding TextOpacity}" Margin="0,8,0,0" AutomationProperties.Name="Text opacity"/></StackPanel>
                        </Grid>
                        <TextBlock Text="Text color" Margin="0,16,0,7"/>
                        <TextBox Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}" Width="180" HorizontalAlignment="Left" AutomationProperties.Name="Text color"/>
                        <TextBlock Text="{Binding ColorError}" Foreground="#FFBAA8" FontSize="12" Margin="0,5,0,0"/>
                        <Border Background="#0F1318" CornerRadius="6" Padding="14" Margin="0,14,0,0">
                            <StackPanel><TextBlock Text="LIVE LYRIC PREVIEW" Style="{StaticResource Caption}" FontSize="10"/><TextBlock Text="{Binding CurrentLyric}" FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}" Foreground="{Binding LyricBrush}" Opacity="{Binding TextOpacity}" TextAlignment="Center" Margin="0,10,0,6"/><TextBlock Text="Preview follows the current track when timed lyrics are available." Style="{StaticResource Caption}" HorizontalAlignment="Center"/></StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="Overlay" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Content="Lock overlay · clicks pass through to the app underneath" IsChecked="{Binding Locked}"/>
                        <CheckBox Content="Keep lyrics above other desktop windows" IsChecked="{Binding AlwaysOnTop}"/>
                        <TextBlock Text="Display width" Margin="0,14,0,6"/>
                        <DockPanel><TextBlock Text="{Binding OverlayWidth, StringFormat={}{0:0} px}" DockPanel.Dock="Right" Width="70" TextAlignment="Right"/><Slider Minimum="300" Maximum="1600" Value="{Binding OverlayWidth}" AutomationProperties.Name="Display width"/></DockPanel>
                        <Button Content="Move to bottom center" Command="{Binding CenterCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                        <TextBlock Text="Unlock to drag the overlay. The editing surface disappears when locked. Exclusive fullscreen games may cover desktop overlays." Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Section}">
                    <StackPanel><TextBlock Text="General" Style="{StaticResource SectionTitle}"/><CheckBox Content="Start with settings hidden in the system tray" IsChecked="{Binding StartInTray}"/><TextBlock Text="Closing this window keeps lyrics running. Open settings or exit from the system tray." Style="{StaticResource Caption}" Margin="0,8,0,0"/><Button Content="Exit Floating Lyrics" Command="{Binding ExitCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel>
                </Border>
                <TextBlock Text="Open source · MIT license · No telemetry. Only the current track metadata is sent to LRCLIB when configured. Player compatibility depends on Windows media-session support." Style="{StaticResource Caption}" Margin="2,6,2,14"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#171D24" Padding="30,12"><TextBlock Text="{Binding SaveStatus}" Style="{StaticResource Caption}"/></Border>
    </Grid>
</Window>
